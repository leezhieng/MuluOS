#!/usr/bin/env python3
"""Render /etc/profile.d/muluos-env.sh from registry env.* keys.

Source of truth is the SQLite-backed registry (machine scope of the
reserved bundle `muluos.system`):

    env.path        colon-joined directories prepended to PATH
    env.var.<NAME>  value for environment variable NAME
"""
from __future__ import annotations
import shlex
import sys
from pathlib import Path

import muluos_registry as reg

SYSTEM_BUNDLE = "muluos.system"
PATH_KEY = "env.path"
VAR_PREFIX = "env.var."
OUTPUT = Path("/etc/profile.d/muluos-env.sh")


def main() -> int:
    client = reg.Client.connect_direct()
    lines = [
        "# Generated by muluos-env-editor. Do not edit by hand.",
        "# Source of truth: MuluOS registry (env.* on muluos.system).",
        "",
    ]

    path_extra = client.machine_get(SYSTEM_BUNDLE, PATH_KEY, "") or ""
    dirs = [d for d in path_extra.split(":") if d]
    if dirs:
        lines.append(f'export PATH={shlex.quote(":".join(dirs))}:"$PATH"')

    for item in client.machine_list(SYSTEM_BUNDLE, prefix=VAR_PREFIX):
        name = item["key"][len(VAR_PREFIX):]
        if not name.isidentifier():
            continue
        lines.append(f"export {name}={shlex.quote(str(item['value']))}")

    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
    OUTPUT.write_text("\n".join(lines) + "\n")
    OUTPUT.chmod(0o644)
    return 0


if __name__ == "__main__":
    sys.exit(main())
