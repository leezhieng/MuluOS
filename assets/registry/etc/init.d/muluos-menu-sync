#!/sbin/openrc-run
name="muluos-menu-sync"
description="Regenerate KDE menu from MuluOS registry"

command="/usr/libexec/muluos/menu-sync"

depend() {
    need muluos-registryd
    before xdm sddm
}

start() {
    ebegin "Syncing MuluOS menu from registry"
    "$command"
    eend $?
}

stop() {
    return 0
}
